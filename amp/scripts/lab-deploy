#!/usr/bin/env bash
# First deploy: uploads this project to AMP and remembers YOUR deployment's id, so later
# pushes never land on a teammate's crew (every attendee's project is named policy_qa).
set -euo pipefail
cd /home/crew/lab/policy_qa
if [ -s .deployment-id ]; then
  echo "Already deployed (id $(cat .deployment-id)). To upload changes, run: lab-push"; exit 0
fi
echo "+ crewai deploy create"
out=$(crewai deploy create -y 2>&1 | tee /dev/stderr)
id=$(printf '%s\n' "$out" | sed -n 's/^Name: .*(\([0-9a-f-]\{36\}\)).*/\1/p' | head -1)
[ -n "$id" ] || { echo "Could not read the deployment id from the output above." >&2; exit 1; }
echo "$id" > .deployment-id
echo; echo "Your deployment id: $id (saved in .deployment-id). Check progress with: lab-status"
